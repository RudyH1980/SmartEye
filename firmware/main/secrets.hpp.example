/**
 * @file secrets.hpp.example
 * @brief Copy to secrets.hpp and fill in; secrets.hpp is not in git
 *
 * The phone setup page stores the system, the address and the key on the
 * device. These constants are used only when that page has not stored a
 * choice yet. A stored choice runs only that system.
 *
 * The Home Assistant token comes from your profile, Security tab, then
 * "Long-lived access tokens" at the bottom.
 */

#pragma once

#define SMARTEYE_SECRETS_VERSION 2

constexpr const char *HA_HOST = "192.168.1.109";
constexpr const char *HA_TOKEN = "";

// Homey Pro on the LAN. API key: Homey Web App, Settings, API Keys.
// Leave the key empty to keep Home Assistant as the only house source.
// HOMEY_ZONE is the zone name, empty shows every zone. A Home Assistant
// room helper overrides this zone only when no choice is stored on the
// device and the Home Assistant token is set too.
constexpr const char *HOMEY_HOST = "192.168.1.50";
constexpr const char *HOMEY_TOKEN = "";
constexpr const char *HOMEY_ZONE = "";
